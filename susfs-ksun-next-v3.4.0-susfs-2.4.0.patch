 }
 
 /*
@@ -270,3 +273,37 @@ void escape_to_root_for_adb_root(void)
     }
     commit_creds(cred);
 }
+
+
+#ifdef CONFIG_KSU_SUSFS
+u32 susfs_ksu_sid __read_mostly;
+u32 susfs_init_sid __read_mostly;
+u32 susfs_zygote_sid __read_mostly;
+u32 susfs_zygote_next_sid __read_mostly;
+u32 susfs_priv_app_sid __read_mostly;
+
+static void susfs_set_sid(const char *secctx_name, u32 *out_sid)
+{
+	int err = security_secctx_to_secid(secctx_name, strlen(secctx_name),
+					   out_sid);
+
+	if (err) {
+		*out_sid = 0;
+		pr_warn("susfs: failed to resolve %s: %d\n", secctx_name, err);
+	}
+}
+
+void susfs_set_batch_sid(void)
+{
+	susfs_set_sid(KERNEL_SU_CONTEXT, &susfs_ksu_sid);
+	susfs_set_sid(INIT_CONTEXT, &susfs_init_sid);
+	susfs_set_sid(ZYGOTE_CONTEXT, &susfs_zygote_sid);
+	susfs_set_sid("u:r:zygote_next:s0", &susfs_zygote_next_sid);
+	susfs_set_sid("u:r:priv_app:s0:c512,c768", &susfs_priv_app_sid);
+}
+
+bool susfs_is_current_ksu_domain(void)
+{
+	return unlikely(susfs_ksu_sid && current_sid() == susfs_ksu_sid);
+}
+#endif
