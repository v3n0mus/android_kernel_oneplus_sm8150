@@ -64,12 +72,31 @@ int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 	} else {
 #ifdef KSU_KPROBES_HOOK
 		ksu_clear_task_tracepoint_flag_if_needed(current);
+#endif
+#ifdef CONFIG_KSU_SUSFS
+		bool is_zygote_child = current_sid() == susfs_zygote_sid;
+		bool is_zygote_next_child = susfs_zygote_next_sid &&
+			current_sid() == susfs_zygote_next_sid;
+		bool should_umount = is_isolated_process(new_uid) ||
+			(is_appuid(new_uid) && ksu_uid_should_umount(new_uid));
+
+		susfs_set_current_proc_no_su();
+		if ((is_zygote_child || is_zygote_next_child) && should_umount) {
+			susfs_set_current_proc_umounted();
+			if (is_zygote_next_child)
+				susfs_set_current_proc_umounted_for_zygote_next();
+		}
 #endif
     }
 
     // Handle kernel umount
     ksu_handle_umount(old_uid, new_uid);
 
+#ifdef CONFIG_KSU_SUSFS
+	if (susfs_is_current_proc_umounted() && !work_pending(&susfs_extra_works))
+		schedule_work(&susfs_extra_works);
+#endif
+
     return 0;
 }
 
