     return is_sid_match(cred, cached_init_sid, INIT_CONTEXT);
 }
 
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+u32 ksu_get_zygote_sid(void)
+{
+    if (unlikely(!cached_zygote_sid)) {
+        int err = security_secctx_to_secid(ZYGOTE_CONTEXT,
+                                           strlen(ZYGOTE_CONTEXT),
+                                           &cached_zygote_sid);
+        if (err) {
+            pr_warn("Failed to resolve zygote SID: %d\n", err);
+            cached_zygote_sid = 0;
+        }
+    }
+    return cached_zygote_sid;
+}
+
+u32 ksu_get_current_sid(void)
+{
+    return current_sid();
+}
+#endif
