diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 3184deb..0853524 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -21,15 +21,36 @@
 #include "hook/hook_manager.h"
 #include "feature/kernel_umount.h"
 #include "compat/kernel_compat.h"
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
+#include "selinux/selinux.h"
+#endif
 
 extern void disable_seccomp(struct task_struct *tsk);
 
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+static u32 susfs_zygote_sid;
+#endif
+
 int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 {
     // we rely on the fact that zygote always call setresuid(3) with same uids
 
     pr_info("handle_setresuid from %d to %d\n", old_uid, new_uid);
 
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+    if (unlikely(new_uid == 0 && is_zygote(current_cred())))
+        susfs_zygote_sid = ksu_get_zygote_sid();
+
+    bool is_zygote_child = susfs_zygote_sid &&
+                           susfs_zygote_sid == ksu_get_current_sid();
+    if (unlikely(is_zygote_child &&
+                 !(current->android_kabi_reserved1 & TASK_STRUCT_KABI1_IS_ZYGOTE))) {
+        current->android_kabi_reserved1 |= TASK_STRUCT_KABI1_IS_ZYGOTE;
+        pr_info("susfs: Found newly created zygote process\n");
+    }
+#endif
+
     if (unlikely(is_uid_manager(new_uid))) {
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
@@ -64,6 +85,26 @@ int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 	} else {
 #ifdef KSU_KPROBES_HOOK
 		ksu_clear_task_tracepoint_flag_if_needed(current);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+        if (is_appuid(new_uid))
+            current->user->android_kabi_reserved1 |=
+                USER_STRUCT_KABI1_NON_ROOT_USER_APP_PROFILE;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+        if (unlikely(is_zygote_child && new_uid >= 1000 && new_uid < 10000)) {
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+            susfs_try_umount(new_uid);
+#endif
+            return 0;
+        }
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+        if (unlikely(is_zygote_child &&
+                     (is_appuid(new_uid) || is_isolated_process(new_uid)) &&
+                     (ksu_uid_should_umount(new_uid) ||
+                      is_isolated_process(new_uid))))
+            susfs_try_umount(new_uid);
+#endif
 #endif
     }
 
