diff --git a/kernel/feature/susfs.c b/kernel/feature/susfs.c
new file mode 100644
index 0000000..684522d
--- /dev/null
+++ b/kernel/feature/susfs.c
@@ -0,0 +1,114 @@
+#include <linux/cred.h>
+#include <linux/susfs.h>
+#include <linux/uaccess.h>
+
+#include "compat/kernel_compat.h"
+#include "feature/susfs.h"
+#include "klog.h" // IWYU pragma: keep
+
+static int susfs_copy_result(unsigned long arg5, int error)
+{
+	if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+		pr_info("susfs: copy_to_user() failed\n");
+	return 0;
+}
+
+int ksu_handle_prctl(int option, unsigned long arg2, unsigned long arg3,
+		     unsigned long arg4, unsigned long arg5)
+{
+	int error = 0;
+
+	if (current_uid().val != 0)
+		return 0;
+
+	switch (arg2) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	case CMD_SUSFS_ADD_SUS_PATH:
+		if (!ksu_access_ok((void __user *)arg3,
+				   sizeof(struct st_susfs_sus_path)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			pr_err("susfs: CMD_SUSFS_ADD_SUS_PATH -> invalid user pointer\n");
+			return 0;
+		}
+		error = susfs_add_sus_path(
+			(struct st_susfs_sus_path __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	case CMD_SUSFS_ADD_SUS_MOUNT:
+		if (!ksu_access_ok((void __user *)arg3,
+				   sizeof(struct st_susfs_sus_mount)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			pr_err("susfs: CMD_SUSFS_ADD_SUS_MOUNT -> invalid user pointer\n");
+			return 0;
+		}
+		error = susfs_add_sus_mount(
+			(struct st_susfs_sus_mount __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		if (!ksu_access_ok((void __user *)arg3,
+				   sizeof(struct st_susfs_sus_kstat)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			pr_err("susfs: CMD_SUSFS_ADD_SUS_KSTAT -> invalid user pointer\n");
+			return 0;
+		}
+		error = susfs_add_sus_kstat(
+			(struct st_susfs_sus_kstat __user *)arg3);
+		break;
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+		if (!ksu_access_ok((void __user *)arg3,
+				   sizeof(struct st_susfs_sus_kstat)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			pr_err("susfs: CMD_SUSFS_UPDATE_SUS_KSTAT -> invalid user pointer\n");
+			return 0;
+		}
+		error = susfs_update_sus_kstat(
+			(struct st_susfs_sus_kstat __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	case CMD_SUSFS_ADD_TRY_UMOUNT:
+		if (!ksu_access_ok((void __user *)arg3,
+				   sizeof(struct st_susfs_try_umount)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			pr_err("susfs: CMD_SUSFS_ADD_TRY_UMOUNT -> invalid user pointer\n");
+			return 0;
+		}
+		error = susfs_add_try_umount(
+			(struct st_susfs_try_umount __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	case CMD_SUSFS_SET_UNAME:
+		if (!ksu_access_ok((void __user *)arg3,
+				   sizeof(struct st_susfs_uname)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			pr_err("susfs: CMD_SUSFS_SET_UNAME -> invalid user pointer\n");
+			return 0;
+		}
+		error = susfs_set_uname((struct st_susfs_uname __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	case CMD_SUSFS_ENABLE_LOG:
+		if (arg3 != 0 && arg3 != 1) {
+			pr_err("susfs: CMD_SUSFS_ENABLE_LOG -> arg3 can only be 0 or 1\n");
+			return 0;
+		}
+		if (!ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			pr_err("susfs: CMD_SUSFS_ENABLE_LOG -> invalid result pointer\n");
+			return 0;
+		}
+		susfs_set_log(arg3);
+		break;
+#endif
+	default:
+		return 0;
+	}
+
+	pr_info("susfs: command 0x%lx -> ret: %d\n", arg2, error);
+	return susfs_copy_result(arg5, error);
+}
